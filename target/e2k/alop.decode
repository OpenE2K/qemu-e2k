# Argument sets:
&alf1        sm dst src1 src2
&alf1_mas    sm dst src1 src2 mas
&alf1_lit8   sm dst src1 src2 imm
&alf2        sm dst src2
&alf2_pshufh sm dst src2 imm
&alf2_icalld sm dst src2 wbs
