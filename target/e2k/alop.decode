&alf13_mas   sm src4 aad aaindex aaincr aas aainc aalit mas

# Formats:
@alf1        ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf1          %sm %dst %src1 %src2
@alf1_mas    ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf1_mas      %sm %dst %src1 %src2 %mas
@alf1_lit8   ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf1_lit8     %sm %dst %src1 %src2 imm=%src3
@alf2        ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf2          %sm %dst %src2
@alf2_pshufh ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf2_pshufh   %sm %dst %src2 imm=%src3
@alf2_icalld ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf2_icalld   %sm %dst %src2 wbs=%src1
@alf3_mas    ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf3_mas      %sm %src4 %src1 %src2 %mas
@alf7        ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf7          %sm dst=%pdst %src1 %src2
@alf8        ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf8          %sm dst=%pdst %src2
@alf15       ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf15         %sm %dst %src2
@alf16       ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf16         %sm %dst %src1
@alf21       ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf21         %sm %dst %src1 %src2 %src3
@alf21_log   ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf21_log     %sm %dst %src1 %src2 %src3 %map
@alf10_mas   ...... ....... ... ........ ........ . ....... ........ ........ ........ &alf10_mas     %sm %dst %aad %aaindex %aaincr %aas %aainc %aalit %mas
